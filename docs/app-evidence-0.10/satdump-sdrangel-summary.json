  "observations": [
    {
      "id": "APP-01",
      "type": "REA inventory + plist/file/otool parsing",
      "finding": "SatDump 1.2.3 and SDRangel 7.27.1 include arm64 executables. CLI satdump LC_BUILD_VERSION minos=11.0; SDRangel main executable minos=14.0. This does not establish every nested dependency minimum."
    },
    {
      "id": "APP-02",
      "type": "Bounded format-aware resource parse",
      "finding": "76 SatDump pipeline JSONC files parse to 194 top-level pipeline definitions. METEOR LRPT pipelines start at complex baseband, not narrow demodulated audio."
    },
    {
      "id": "APP-03",
      "type": "Resource parse + NOAA current primary source",
      "finding": "Installed NOAA APT pipeline remains marked live=true and names NOAA 15/18/19. Those satellites are retired; use historical recordings and do not import live status blindly."
    },
    {
      "id": "APP-04",
      "type": "REA inventory + shell symbol lookup + current upstream docs",
      "finding": "SDRangel includes DSC, AIS, RS41, Inmarsat, Meshtastic and MeshCore plugins. DSC exposes receiveBit/processOneSample and Qt-bound interfaces; it is not a standalone PCM helper."
    },
    {
      "id": "APP-05",
      "type": "Design proposal",
      "finding": "Separate audio, flat discriminator, complex I/Q and decoded-event inputs. Record RF metadata and decoder versions; network decoded feeds must retain external-source attribution."
    }
  ],
