  "findings": [
    {
      "id": "DMRB-01",
      "evidence_type": "shipped static symbols/strings",
      "conclusion": "Plugin distributes NewDSD and legacy DSD, DMR voice/data and mbelib AMBE/IMBE functions. Runtime activation and reception quality unknown."
    },
    {
      "id": "DMRB-02",
      "evidence_type": "pinned source",
      "conclusion": "New path complex input at 9600 samples/s -> quadrature FM -> DC blocker -> RRC -> clock recovery 4800 symbols/s -> four-level slicer -> NewDSD -> mbelib -> 8000 Hz PCM. Old path demodulates to PCM16 at 48000 before legacy DSD."
    },
    {
      "id": "DMRB-03",
      "evidence_type": "pinned source + ETSI reference",
      "conclusion": "SLOT0/1 are zero-based slot indices derived from CACH, not frequencies. DMR state exposes CC and burst type; SRC/TG/ALGID/KID are in the distinct P25 state."
    },
    {
      "id": "DMRB-04",
      "evidence_type": "bounded negative source search",
      "conclusion": "Inspected DMR/vocoder files did not establish a DMR key/configuration/decryption path or reliable DMR encryption indicator. This is not a universal claim about every fork."
    },
    {
      "id": "DMRB-05",
      "evidence_type": "source vs bounded negative binary search",
      "conclusion": "Current pinned main adds get_dmr_status/wait_dmr_sync_voice JSON debug commands. Literal names/accessors not found in retained installed-plugin strings/exports; availability in the installed copy remains unconfirmed."
    },
    {
      "id": "DMRB-06",
      "evidence_type": "RadioWorkbench source + prior validation",
      "conclusion": "Current application transports raw PCM16 mono at 48 kHz to DSD-neo 2.10.0, DMR -fs, headless, -o null plus -w temporary WAV; play/export after stop. No new DMR RF validation; previous voice test is synthetic M17."
    },
    {
      "id": "DMRB-07",
      "evidence_type": "design recommendation backed by pinned CLI/contracts",
      "conclusion": "Extend existing DSD-neo with live PCM output, explicit TS1/TS2/both controls and typed per-call status; do not feed already decoded Brown voice to a second DMR decoder."
    }
  ],
  "verified_dsd_cli_contracts": {
    "input": "-i - ; -s 48000 ; raw s16le mono",
    "decoded_audio": "-o - or -o udp:host:port ; digital decoded voice 8000 Hz, channel count/type must be verified for selected mode",
    "dmr": "-fs dual-slot ; -fr single-slot mono",
    "voice_slots": "-V 0 off; 1 TS1; 2 TS2; 3 both",
    "slot_preference": "-z 0 TS1; 1 TS2; 2 auto",
    "event_log": "-J file is textual event log, not established general JSON CLI",
    "snapshots": "single-consumer C snapshot accessors; last values may persist after stop, so lifecycle must be tracked separately"
  },
