  "findings": [
    {
      "id": "HFCC-ZIP-MEMBER",
      "severity": "functional defect",
      "observation": "Downloaded a26allx2.zip contains A26all00.TXT; inspected service accepted only a26allx2.txt. Valid public download therefore failed with cannotFindHost.",
      "recommendation": "Accept exact season-specific known names, reject missing/ambiguous candidates; never choose first arbitrary text member."
    },
    {
      "id": "HFCC-WEEKDAY",
      "severity": "association correctness",
      "observation": "HFCC Sunday=1 and Saturday=7; current BroadcastCalendar EiBi numeric convention Monday=1 and Sunday=7.",
      "recommendation": "Use separate UTC HFCC day conversion; 23456 means Monday-Friday, 1 means Sunday."
    },
    {
      "id": "HFCC-DATE-POLICY",
      "severity": "unresolved source semantics",
      "observation": "DDMMYY specified, but consulted sources did not explicitly settle final-day inclusivity or all overnight weekday anchors.",
      "recommendation": "Record policy and test full UTC dates, midnight, month/year and season boundaries before automatic power association."
    },
    {
      "id": "HFCC-POWER",
      "severity": "physical quantity semantics",
      "observation": "kW is DSB carrier power or SSB peak envelope power; below 1kW must be filed as 1. Not measured radiated power or ERP/EIRP."
    },
    {
      "id": "HFCC-AZIMUTH",
      "severity": "physical model semantics",
      "observation": "0 degrees can represent nondirectional antenna; do not infer a north-facing beam from zero alone."
    }
  ],
